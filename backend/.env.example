# Copia este archivo como .env y complétalo. NUNCA subas el archivo .env al repositorio.

# entorno
NODE_ENV=development
PORT=3000

# origenes permitidos para el navegador, separados por coma
ALLOWED_ORIGINS=http://localhost:3001

# conexion a postgresql (supabase) - usar el proyecto de STAGING para desarrollo
# se obtiene en: supabase > project settings > database > connection string (session mode)
DATABASE_URL=postgresql://usuario:contrasena@host:5432/postgres

# datos del proyecto supabase (para validar el token de los usuarios)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_JWT_SECRET=

# minutos que se retiene un asiento mientras el cliente paga (ADR-001)
MINUTOS_RESERVA_ASIENTO=10
