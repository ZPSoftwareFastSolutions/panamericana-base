# copia este archivo como .env y completalo. NUNCA subas el archivo .env al repositorio.

# entorno
NODE_ENV=development
PORT=4000

# origenes permitidos para el navegador, separados por coma (la web corre en el 3000)
ALLOWED_ORIGINS=http://localhost:3000

# proyecto supabase compartido del equipo: panamericana (ref tvyhpwpyxmbdfxogopnl)
SUPABASE_URL=https://tvyhpwpyxmbdfxogopnl.supabase.co

# se usa en la epica de login (E1): supabase > project settings > api > jwt
SUPABASE_JWT_SECRET=

# cadena de conexion a postgresql.
# se copia del panel: supabase > connect > session pooler (o direct connection)
# formato de conexion directa:
#   postgresql://postgres:CONTRASENA@db.tvyhpwpyxmbdfxogopnl.supabase.co:5432/postgres
# la contrasena esta en: supabase > project settings > database > database password
DATABASE_URL=

# minutos que se retiene un asiento mientras el cliente paga (ADR-001)
MINUTOS_RESERVA_ASIENTO=10
