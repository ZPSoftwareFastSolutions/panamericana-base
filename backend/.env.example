# copia este archivo como .env y completalo. NUNCA subas el archivo .env al repositorio.

# entorno
NODE_ENV=development
PORT=4000

# origenes permitidos para el navegador, separados por coma (la web corre en el 3000)
ALLOWED_ORIGINS=http://localhost:3000

# proyecto supabase compartido del equipo: panamericana (ref tvyhpwpyxmbdfxogopnl)
SUPABASE_URL=https://tvyhpwpyxmbdfxogopnl.supabase.co

# se usa cuando se implemente el login: supabase > project settings > api > jwt
SUPABASE_JWT_SECRET=

# cadena de conexion a postgresql. usar SESSION POOLER (ipv4).
# la conexion directa (db.<ref>.supabase.co) es solo ipv6 y falla en la mayoria
# de redes con el error: getaddrinfo ENOTFOUND
# formato verificado (solo falta la contrasena, que se pide por canal privado):
#   postgresql://postgres.tvyhpwpyxmbdfxogopnl:CONTRASENA@aws-0-us-east-1.pooler.supabase.com:5432/postgres
DATABASE_URL=

# minutos que se retiene un asiento mientras el cliente paga
MINUTOS_RESERVA_ASIENTO=10
