# copia este archivo como .env y completalo. NUNCA subas el archivo .env al repositorio.

# entorno
NODE_ENV=development
PORT=4000

# origenes permitidos para el navegador, separados por coma (la web corre en el 3000)
ALLOWED_ORIGINS=http://localhost:3000

# conexion a postgresql (supabase) - usar el proyecto de STAGING para desarrollo
# supabase > project settings > database > connection string > session mode
DATABASE_URL=postgresql://usuario:contrasena@host:5432/postgres

# datos del proyecto supabase (para validar el token de los usuarios, epica E1)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_JWT_SECRET=

# minutos que se retiene un asiento mientras el cliente paga (ADR-001)
MINUTOS_RESERVA_ASIENTO=10
